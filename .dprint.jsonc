{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://github.com/kjanat/kjanat/raw/886a886/configs/dprint.remote.json",
	"dockerfile": { "associations": ["Dockerfile", "Dockerfile.*"] },
	"newLineKind": "lf",
	"exec": {
		"cwd": "${configDir}",
		"commands": [{
			"command": "tombi format - --stdin-filename {{file_path}}",
			"exts": ["toml"],
		}, {
			"command": "just --dump",
			"fileNames": ["justfile"],
		}],
	},
	"excludes": ["**/node_modules", "**/*-lock.json", "**/bun.lock*", "**/.venv"],
	"plugins": [
		"https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
	],
}
